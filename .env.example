# ── Database (produkcja: connection string Supabase + asyncpg) ──
DATABASE_URL=sqlite+aiosqlite:///./familyorg.db
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Admin (seed / promocja is_app_admin) ──
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=changeme

# ── Security (legacy JWT — lokalne testy bez Supabase) ──
SECRET_KEY=changeme-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Supabase Auth (produkcja) ──
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=<JWT Secret z Project Settings → API>
# SUPABASE_JWT_AUDIENCE=authenticated

# ── CORS ──
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001,http://localhost:80
# Produkcja: CORS_ORIGINS_STR=https://family.fmazurkiewicz.dev
