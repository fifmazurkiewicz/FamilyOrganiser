# ── Database ──
# Local: native Postgres (preferred) or SQLite fallback. Production (Render): Supabase pooler.
DATABASE_URL=sqlite+aiosqlite:///./familyorg.db
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@127.0.0.1:5432/familyorganiser
# Production Render (pooler, not db.<ref>.supabase.co):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Admin (seed lokalny / promocja is_app_admin po logowaniu Supabase) ──
ADMIN_EMAIL=fifmazurkiewicz@gmail.com
ADMIN_PASSWORD=changeme

# ── Security (legacy JWT — lokalne testy bez Supabase) ──
SECRET_KEY=changeme-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Supabase Auth (required on Render) ──
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=<JWT Secret z Project Settings → API>
# SUPABASE_SERVICE_ROLE_KEY=<service_role — backend Render only, never VITE_*>
# SUPABASE_JWT_AUDIENCE=authenticated

# ── CORS ──
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001,http://localhost:80
# Produkcja: CORS_ORIGINS_STR=https://family.fmazurkiewicz.dev

# ── Runtime (Render Docker) ──
# PORT=8080
